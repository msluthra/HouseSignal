# App
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STREAMLIT_SERVER_PORT=8501

# Database
DATABASE_URL=sqlite:///./housesignal.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Supabase public/browser-safe values
SUPABASE_MODE=mock
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Backend-only Supabase secrets
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-backend-only
SUPABASE_JWT_SECRET=replace-with-jwt-secret-backend-only
SUPABASE_STORAGE_BUCKET=deal-documents

# Backend-only AI/API keys
OPENAI_API_KEY=replace-with-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
RENTCAST_API_KEY=replace-with-rentcast-key
RENTCAST_BASE_URL=https://api.rentcast.io/v1
RENTCAST_DAILY_LIMIT=5
RENTCAST_CACHE_TTL_HOURS=720

# Legacy/provider placeholders
REDFIN_API_KEY=
ZILLOW_API_KEY=
FIRM_DATA_PATH=data/raw/firm_deals.csv
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
